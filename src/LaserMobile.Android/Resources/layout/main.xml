<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="GRBL Tool Mobile" android:textSize="26sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:text="工程验证版 · USB 设备发现与无光模拟任务" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/scan" android:text="扫描 USB 串口" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/devices" android:text="点击扫描查看受支持设备" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/simulate" android:text="运行后台模拟任务" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/status" android:text="尚未运行" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <FrameLayout android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="240dp" />
  </LinearLayout>
</ScrollView>
